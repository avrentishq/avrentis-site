# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# planning and internal docs (top-level only — do not ignore src/app/docs
# or src/components/docs which are the public /docs route).
#
# `/docs/*` and `.claude/*` are deliberately written WITHOUT a trailing slash:
# a trailing slash stops git descending into the directory at all, which makes
# every `!` negation below it inert. Matching the children instead lets the
# negations re-include the two directories we do want tracked.
/docs/*
!/docs/architecture/
/guides/
.claude/*
!.claude/skills/
