# Avrentis Marketing Site — Code Ownership Map
#
# Precedence: LAST matching pattern wins (GitHub CODEOWNERS evaluates bottom-up).
# Broader patterns are placed earlier; specific overrides come later.
#
# Teams:
#   @edidi-hq/product    — Product Experience: marketing pages, design system, copy
#   @edidi-hq/platform   — Platform & Security: external service clients, platform API contracts
#   @edidi-hq/identity   — Identity & Compliance: legal copy, trust/security posture, disclosure controls
#   @edidi-hq/infra      — Infrastructure & DX: CI, deploy config, build tooling
#   @edidi-hq/founders   — Founder override for load-bearing public commitments
#
# Teams not represented here (@workflow, @data) have no surface in the marketing
# site and are intentionally unassigned. Add them only if scope changes warrant.
#
# No catch-all default — new paths must claim ownership at create time.

# ─────────────────────────────────────────────────────────────────────────────
# Product Experience — broad ownership of the marketing surface.
# Specific carve-outs override these patterns below.
# ─────────────────────────────────────────────────────────────────────────────

src/                                    @edidi-hq/product

# ─────────────────────────────────────────────────────────────────────────────
# Platform & Security
# Touches external service credentials and platform API contracts.
# ─────────────────────────────────────────────────────────────────────────────

# Resend client — RESEND_API_KEY handling
src/lib/email.ts                        @edidi-hq/platform

# Trial flow — forwards to platform trial API + handles magic-link verify redirect
src/app/trial/                          @edidi-hq/product @edidi-hq/platform

# Contact form server action — dispatches mail via Resend
src/app/contact/actions.ts              @edidi-hq/product @edidi-hq/platform

# ─────────────────────────────────────────────────────────────────────────────
# Identity & Compliance
# Public legal, trust, and security-disclosure surfaces. Co-owned with Product
# so visual treatment changes still go through the design owner. Listed at
# component level too because the same component renders multiple routes.
# ─────────────────────────────────────────────────────────────────────────────

src/app/privacy/                        @edidi-hq/identity @edidi-hq/product
src/app/terms/                          @edidi-hq/identity @edidi-hq/product
src/app/trust/                          @edidi-hq/identity @edidi-hq/product
src/app/product/security/               @edidi-hq/identity @edidi-hq/product
src/components/legal/                   @edidi-hq/identity @edidi-hq/product
src/components/trust/                   @edidi-hq/identity @edidi-hq/product
src/components/product/security-page.tsx     @edidi-hq/identity @edidi-hq/product
src/components/product/security-mockups.tsx  @edidi-hq/identity @edidi-hq/product

# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure & DX
# ─────────────────────────────────────────────────────────────────────────────

